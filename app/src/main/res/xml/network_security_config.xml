<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Termux local backend runs over HTTP (e.g., http://127.0.0.1:3000 or LAN IP). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
